[gd_resource type="Resource" script_class="SteamRollerConfig" format=3 uid="uid://lwxyos7nd4k"]

[ext_resource type="Script" uid="uid://b4h3l5eronhto" path="res://addons/steamroller/config/steamroller_config.gd" id="1_cfg"]
[ext_resource type="Script" uid="uid://dqwdndfgpo67s" path="res://addons/steamroller/config/steamroller_step.gd" id="2_step"]

[sub_resource type="Resource" id="s_version"]
script = ExtResource("2_step")
id = "version"
action = 2
display_name = "Version"
description = "[i]Project version. Persisted to application/config/version. Each build increments the last numeric segment.[/i]"
target_variable = "VERSION"
project_setting_path = "application/config/version"
default_value = "0.0.1"
placeholder = "0.0.1"

[sub_resource type="Resource" id="s_commit"]
script = ExtResource("2_step")
id = "commit_message"
action = 2
display_name = "Message"
description = "[i]Short description of this build. Used by later steps.[/i]"
target_variable = "COMMIT_MESSAGE"
project_setting_path = "application/config/commit_message"
placeholder = "What changed?"

[sub_resource type="Resource" id="s_branch"]
script = ExtResource("2_step")
id = "steam_branch"
action = 2
display_name = "Steam Branch"
description = "[i]Default Steam branch to release on. Written to [code]setlive[/code] in the app VDF scripts.[/i]"
target_variable = "STEAM_BRANCH"
project_setting_path = "application/steamroller/steam_branch"
default_value = "default"
placeholder = "default"

[sub_resource type="Resource" id="s_delete"]
script = ExtResource("2_step")
id = "delete_build"
action = 5
display_name = "Reset the build output folder."
description = "Clears [color=cyan]${BUILDS_DIR}/latest[/color] and recreates the depot subfolders."
depends_on = PackedStringArray("commit_message")
button_label = "Reset build folder"
params = {
"path": "${BUILDS_DIR}/latest",
"paths": ["${BUILDS_DIR}/latest", "${BUILDS_DIR}/latest/game_depot", "${BUILDS_DIR}/latest/demo_depot", "${BUILDS_DIR}/latest/web"]
}

[sub_resource type="Resource" id="s_deck_deploy"]
script = ExtResource("2_step")
id = "deck_deploy"
action = 12
button_label = "Build + run on Deck"
attach_to = "delete_build"
executable = "${BASH_EXE}"
args = PackedStringArray("${DECK_SCRIPT}", "--clean-cache")
working_dir = "${PROJECT_DIR}"

[sub_resource type="Resource" id="s_tests"]
script = ExtResource("2_step")
id = "tests"
action = 3
display_name = "Run the unit tests for this change. Ensure they pass."
description = "Run all [color=cyan]GdUnit4[/color] tests. Disabled if GdUnit is not installed."
depends_on = PackedStringArray("commit_message")

[sub_resource type="Resource" id="s_clear_user"]
script = ExtResource("2_step")
id = "clear_user"
action = 8
button_label = "Clear user data folder"
attach_to = "tests"

[sub_resource type="Resource" id="s_open_user"]
script = ExtResource("2_step")
id = "open_user"
action = 9
button_label = "Open user folder"
attach_to = "tests"
params = {
"path": "${USER_DIR}"
}

[sub_resource type="Resource" id="s_export"]
script = ExtResource("2_step")
id = "export_reminder"
action = 15
display_name = "Export all platforms."
description = "Runs the Godot headless CLI over [i]every[/i] preset in [color=cyan]export_presets.cfg[/color], each to its own export path — the same list the editor's [i]Export All[/i] button walks. [b]Debug and Release write to the same paths[/b], so whichever ran last is what is on disk. Set [code]params.exports[/code] only to override that list with explicit preset/output pairs."
depends_on = PackedStringArray("delete_build")
params = {
"exports": []
}

[sub_resource type="Resource" id="s_movie"]
script = ExtResource("2_step")
id = "movie"
action = 4
display_name = "Record gameplay, or play the build and copy the saves."
description = "[b]Record gameplay[/b] plays the main scene in Movie Maker mode into [color=cyan]${BUILDS_DIR}/latest/gameplay.ogv[/color], then re-encodes it to MP4 with ffmpeg. [b]Copy saves[/b] instead merges the game's save folders (this machine's, and a Steam Deck's when one answers) into [color=cyan]${BUILDS_DIR}/latest[/color]; edit its folder names after [code]--[/code]. Either one unlocks the archive."
depends_on = PackedStringArray("export_reminder")
params = {
"output_path": "${BUILDS_DIR}/latest/gameplay.ogv",
"reencode": true
}

[sub_resource type="Resource" id="s_copy_saves"]
script = ExtResource("2_step")
id = "copy_saves"
action = 12
button_label = "Copy saves"
attach_to = "movie"
executable = "${BASH_EXE}"
args = PackedStringArray("${PULL_SAVES_SCRIPT}", "--dest", "${BUILDS_DIR}/latest", "--local", "${USER_DIR}", "--local", "${USER_DIR_DEMO}", "--deck", "auto", "--", "saves")
working_dir = "${PROJECT_DIR}"

[sub_resource type="Resource" id="s_archive"]
script = ExtResource("2_step")
id = "archive"
action = 7
display_name = "Archive this build for future reference."
description = "Copies [color=cyan]${BUILDS_DIR}/latest[/color] → [color=cyan]${BUILDS_DIR}/${VERSION}_${COMMIT_MESSAGE_SLUG}[/color] (newer files only, so archiving twice is safe)."
depends_on_any = PackedStringArray("movie", "copy_saves")
params = {
"destination": "${BUILDS_DIR}/${VERSION}_${COMMIT_MESSAGE_SLUG}",
"source": "${BUILDS_DIR}/latest"
}

[sub_resource type="Resource" id="s_open_build"]
script = ExtResource("2_step")
id = "open_build"
action = 9
button_label = "Open build folder"
attach_to = "archive"
params = {
"path": "${BUILDS_DIR}/latest"
}

[sub_resource type="Resource" id="s_review"]
script = ExtResource("2_step")
id = "code_review"
display_name = "Do a final code review (make sure nothing weird got in the commit)."
depends_on = PackedStringArray("archive")

[sub_resource type="Resource" id="s_copy"]
script = ExtResource("2_step")
id = "copy_commit"
action = 10
display_name = "Commit and push your changes to source control."
description = "Copies to the clipboard:
[code]git commit -m \"${VERSION} ${COMMIT_MESSAGE}\"[/code]"
depends_on = PackedStringArray("code_review")
button_label = "Copy git commit"
params = {
"text": "git commit -m \"${VERSION} ${COMMIT_MESSAGE}\""
}

[sub_resource type="Resource" id="s_reset"]
script = ExtResource("2_step")
id = "reset_increment_1"
action = 11
display_name = "Reset this panel and increment the build"
button_label = "Reset"

[sub_resource type="Resource" id="s_release_tab"]
script = ExtResource("2_step")
action = 1
tab_name = "Release"

[sub_resource type="Resource" id="s_build_ok"]
script = ExtResource("2_step")
id = "build_complete"
display_name = "Smoke-test the archived build before pushing."
description = "Smoke-tested the archived build."

[sub_resource type="Resource" id="s_write_vdf"]
script = ExtResource("2_step")
id = "write_vdf_desc"
action = 14
display_name = "Write the build description into the Steam VDF scripts."
description = "Sets [code]desc[/code] to [color=cyan](${VERSION}) ${COMMIT_MESSAGE}[/color] and [code]setlive[/code] to [color=cyan]${STEAM_BRANCH}[/color] in [color=cyan]app_${STEAM_APP_ID_DEMO}.vdf[/color] and [color=cyan]app_${STEAM_APP_ID_FULL}.vdf[/color]."
depends_on = PackedStringArray("build_complete")
button_label = "Write VDF description"
params = {
"branch": "${STEAM_BRANCH}",
"desc": "(${VERSION}) ${COMMIT_MESSAGE}",
"files": ["${VDF_DIR}/app_${STEAM_APP_ID_DEMO}.vdf", "${VDF_DIR}/app_${STEAM_APP_ID_FULL}.vdf"]
}

[sub_resource type="Resource" id="s_push_builds"]
script = ExtResource("2_step")
id = "push_builds"
display_name = "Push the build to your storefronts."
description = "Demo exports land in [color=cyan]${BUILDS_DIR}/latest/demo_depot[/color] ([i]Windows_Demo[/i], [i]Linux_Demo[/i]). Full game in [color=cyan]game_depot[/color], web in [color=cyan]web[/color]. Use individual buttons or Push all / Push all demo / Push all release."
depends_on = PackedStringArray("write_vdf_desc")

[sub_resource type="Resource" id="s_push_all"]
script = ExtResource("2_step")
id = "push_all"
action = 13
button_label = "Push all"
attach_to = "push_builds"
step_ids = PackedStringArray("push_all_demo", "push_all_release")

[sub_resource type="Resource" id="s_push_all_demo"]
script = ExtResource("2_step")
id = "push_all_demo"
action = 13
display_name = "Push all demo builds to Steam and Itch."
depends_on = PackedStringArray("write_vdf_desc")
button_label = "Push all Demo Builds"
step_ids = PackedStringArray("push_demo_steam", "push_demo_itch")

[sub_resource type="Resource" id="s_push_demo_steam"]
script = ExtResource("2_step")
id = "push_demo_steam"
action = 12
button_label = "Push demo to Steam"
attach_to = "push_all_demo"
new_button_row = true
executable = "${STEAM_CMD_PATH}"
args = PackedStringArray("+login", "${STEAM_USER}", "+run_app_build", "${VDF_DIR}/app_${STEAM_APP_ID_DEMO}.vdf", "+quit")

[sub_resource type="Resource" id="s_push_demo_itch"]
script = ExtResource("2_step")
id = "push_demo_itch"
action = 12
button_label = "Push demo to Itch"
attach_to = "push_all_demo"
executable = "${BUTLER_PATH}"
args = PackedStringArray("push", "${BUILDS_DIR}/latest/demo_depot", "${ITCH_USER}/${ITCH_PROJECT}:demo", "--userversion", "${VERSION}")

[sub_resource type="Resource" id="s_push_all_release"]
script = ExtResource("2_step")
id = "push_all_release"
action = 13
display_name = "Push all release builds to Steam and Itch."
depends_on = PackedStringArray("write_vdf_desc")
button_label = "Push all Release Builds"
step_ids = PackedStringArray("push_game_steam", "push_web_itch", "push_game_itch")

[sub_resource type="Resource" id="s_push_web_itch"]
script = ExtResource("2_step")
id = "push_web_itch"
action = 12
button_label = "Push web demo to Itch"
attach_to = "push_all_release"
new_button_row = true
executable = "${BUTLER_PATH}"
args = PackedStringArray("push", "${BUILDS_DIR}/latest/web", "${ITCH_USER}/${ITCH_PROJECT}:web", "--userversion", "${VERSION}")

[sub_resource type="Resource" id="s_push_game_steam"]
script = ExtResource("2_step")
id = "push_game_steam"
action = 12
button_label = "Push game to Steam"
attach_to = "push_all_release"
executable = "${STEAM_CMD_PATH}"
args = PackedStringArray("+login", "${STEAM_USER}", "+run_app_build", "${VDF_DIR}/app_${STEAM_APP_ID_FULL}.vdf", "+quit")

[sub_resource type="Resource" id="s_push_game_itch"]
script = ExtResource("2_step")
id = "push_game_itch"
action = 12
button_label = "Push game to Itch"
attach_to = "push_all_release"
executable = "${BUTLER_PATH}"
args = PackedStringArray("push", "${BUILDS_DIR}/latest/game_depot", "${ITCH_USER}/${ITCH_PROJECT}:full", "--userversion", "${VERSION}")

[sub_resource type="Resource" id="s_reset_release"]
script = ExtResource("2_step")
id = "reset_increment_2"
action = 11
display_name = "Reset this panel and increment the build"
button_label = "Reset"

[resource]
script = ExtResource("1_cfg")
config_name = "SteamRoller Game Template"
variables = Dictionary[String, String]({
"BASH_EXE": "C:/Program Files/Git/bin/bash.exe",
"BUILDS_DIR": "${PROJECT_DIR}../builds",
"BUTLER_PATH": "${PROJECT_DIR}addons/steamroller/butler-windows-amd64/butler.exe",
"DECK_SCRIPT": "${PROJECT_DIR}addons/steamroller/deck/deploy.sh",
"ITCH_PROJECT": "",
"ITCH_USER": "",
"PULL_SAVES_SCRIPT": "${PROJECT_DIR}addons/steamroller/deck/pull_saves.sh",
"STEAM_APP_ID_DEMO": "480",
"STEAM_APP_ID_FULL": "480",
"STEAM_CMD_PATH": "${PROJECT_DIR}../steamworks_sdk/tools/ContentBuilder/builder/steamcmd.exe",
"STEAM_USER": "",
"VDF_DIR": "${PROJECT_DIR}../steamworks_sdk/tools/ContentBuilder/scripts"
})
steps = Array[ExtResource("2_step")]([SubResource("s_version"), SubResource("s_commit"), SubResource("s_branch"), SubResource("s_delete"), SubResource("s_deck_deploy"), SubResource("s_tests"), SubResource("s_clear_user"), SubResource("s_open_user"), SubResource("s_export"), SubResource("s_movie"), SubResource("s_copy_saves"), SubResource("s_archive"), SubResource("s_open_build"), SubResource("s_review"), SubResource("s_copy"), SubResource("s_reset"), SubResource("s_release_tab"), SubResource("s_build_ok"), SubResource("s_write_vdf"), SubResource("s_push_builds"), SubResource("s_push_all"), SubResource("s_push_all_demo"), SubResource("s_push_demo_steam"), SubResource("s_push_demo_itch"), SubResource("s_push_all_release"), SubResource("s_push_web_itch"), SubResource("s_push_game_steam"), SubResource("s_push_game_itch"), SubResource("s_reset_release")])
