# deck.env -- local Steam Deck deploy config for addons/steamroller/deck/deploy.sh.
#
#   cp addons/steamroller/templates/deck.env.example data/deck.env
#
# then fill in DECK_HOST and GODOT_BIN and run `deploy.sh --doctor`.
#
# The script looks for <project>/data/deck.env; `deploy.sh --env FILE` reads a
# different file. Gitignore it in the host project (e.g. `data/deck.env`): it is
# the only place the Deck's address and user are recorded. Every key is optional
# except GODOT_BIN (exports) and DECK_HOST (unless steamdeck.local resolves).
#
# Anything exported in the environment overrides this file for one run, e.g.
#   DECK_HOST=192.168.1.20 addons/steamroller/deck/deploy.sh --doctor

# --- Deck ------------------------------------------------------------------

# The Deck's LAN address or hostname. steamdeck.local works when mDNS resolves;
# otherwise find the IP on the Deck with: hostname -I
DECK_HOST=

# SSH user on the Deck. SteamOS default is "deck".
DECK_USER=deck

# Devkit title. This is the name the SteamOS devkit tools and the Steam client
# know the game by: the build lands in ~/devkit-game/<DECK_TITLE>/ and the
# shortcut in the Steam library carries this name. Letters, digits, _ and .
# only -- no hyphens, no spaces.
# Default: application/config/name from project.godot with every other
# character folded to "_" ("My Game" -> "My_Game").
DECK_TITLE=

# Steam compatibility tool the shortcut runs under. SteamLinuxRuntime_sniper is
# the container every Linux Godot export should be tested in. Leave empty to
# run the binary directly on the host (not representative of a Steam release).
DECK_RUNTIME=SteamLinuxRuntime_sniper

# Godot user:// on the Deck, wiped by --clean-cache. Default: derived from
# project.godot (config/name, or custom_user_dir_name when use_custom_user_dir
# is on) under $HOME/.local/share/godot/app_userdata/. Keep $HOME literal --
# the Deck's shell expands it.
DECK_USER_DIR=

# --- Workstation -----------------------------------------------------------

# Godot 4 editor binary used for the headless export, as a Git Bash path.
#
# IMPORTANT: use the same editor whose export templates are installed. A Steam
# install of Godot is self-contained, so its templates live in
#   <install>/editor_data/export_templates/<version>/
# while a standalone build uses %APPDATA%/Godot/export_templates/<version>/.
# Two binaries reporting the same version can differ on whether an export works.
#
# Example (Steam install):
#   GODOT_BIN="/g/Steam/steamapps/common/Godot Engine/godot.windows.opt.tools.64.exe"
GODOT_BIN=

# Export preset from export_presets.cfg. Point it at a Linux preset whose
# export_path is kept clear of the SteamRoller depot folders, e.g.
# builds/steam_deck_testing/<Game>.x86_64.
EXPORT_PRESET=Deck_Testing

# The preset's export folder is wiped before every export, but only when it
# sits under this directory. Default: <project>/../builds, the same folder
# SteamRoller's ${BUILDS_DIR} points at. Git Bash path.
BUILDS_DIR=

# Address the DECK should dial back to reach this workstation's debug server,
# used by --debugger. Leave blank to autodetect: the script asks the Deck what
# address it sees us on ($SSH_CLIENT), which beats guessing between local
# adapters. Set it only if autodetection picks the wrong interface.
DEBUG_HOST=
